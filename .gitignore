node_modules/
dist/
target/
*.tsbuildinfo
.env
.env.local
.oathra/
calls/
coverage/
.DS_Store
packages/cli/assets/
# Release assets are uploaded to GitHub Releases, not committed to the source tree.
packages/cli/oathra-*.tgz
packages/cli/oathra-*.tgz.sha256
packages/cli/README.md
packages/cli/LICENSE
site/media/
# video render workspace: keep only the recorded run and the voice clips it needs
video/.work/*
# Raw recorder frames: 159 MB per take, rebuildable with scripts/record-evidence-demo.mjs.
video/*/frames-*/
# The exports live in docs/media, which Pages deploys; keeping a second copy under video/ only doubles the repo.
video/*/oathra-evidence-*
# Upload-ready renders (same picture, silent audio track added for X); rebuildable from docs/media.
video/*/x/
!video/.work/battle.json
!video/.work/tts/
video/.work/tts/*
!video/.work/tts/*-ft.wav
!video/.work/tts/lines.json

# Generated from source by pnpm build:site
site/playground.js

# Gateway credentials and databases must never enter source control.
.env.gateway
.env.gateway.*
*.sqlite
*.sqlite-wal
*.sqlite-shm

# UI quality workflow: session receipts and captured screens (approved visual baselines, if any, belong in Git)
.ui-quality/
artifacts/ui/

# Empty managed-service setup credentials
.env.managed
.env.managed.*
.oathra-managed/

# Local audit / QA output and agent workspaces: rebuildable, never source.
artifacts/
.agents/
apps/desktop/src-tauri/gen/
# SNS operations ledgers and the one-off status audit kept next to the repo.
/accounts.csv
/activities.csv
/assets.csv
/metrics.csv
/status-audit.md
