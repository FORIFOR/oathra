# Run node apps/gateway/setup.mjs to generate private credentials; never commit .env.gateway.
OATHRA_MODE=simulator
OATHRA_PUBLIC_URL=http://localhost:4244
HOST=127.0.0.1
PORT=4244
# Set to true only when every request arrives through a reverse proxy that overwrites X-Forwarded-For
# (the bundled Caddy setup does). Rate limits are then per client instead of per proxy.
# OATHRA_TRUST_PROXY=true
# Days a finished call (transcript, result, events) and an abandoned draft are kept. Default 30.
# OATHRA_RETENTION_DAYS=30
OATHRA_DB=.oathra/gateway.sqlite
OATHRA_DATA_KEY=
OATHRA_USERS_JSON=
# Live: use your HTTPS public origin and remove simulator contacts/products.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
OPENAI_API_KEY=
OATHRA_VOICE_ENGINE=gpt-live
OATHRA_VOICE_MODEL=gpt-live-1
OATHRA_BUSINESS_NAME=
# Operator-maintained conservative ceiling per leg, not a quoted carrier tariff.
OATHRA_RATE_CEILING_USD=1
OATHRA_SETUP_FEE_USD=0
OATHRA_MAX_CALL_USD=10
OATHRA_MAX_SECONDS=300
OATHRA_DAILY_CALLS=20
OATHRA_DAILY_USD=30
OATHRA_LIVE_POLICY_REVIEWED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional external writes; credentials belong exclusively to this configured operator.
OATHRA_INTEGRATION_OWNER=operator
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
HUBSPOT_ACCESS_TOKEN=
OATHRA_SMS_ENABLED=false

# Optional operator-reviewed local plugins. Restart after changing this file.
# OATHRA_PLUGINS_FILE=.oathra/plugins.json
# OATHRA_CALL_PLUGIN=call
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# OSS: self-hosted (default), no platform credits. Operator supplies carrier/AI credentials.
# Service: managed, credentials stay on the server; requires an explicit positive integer price.
OATHRA_DEPLOYMENT=self-hosted
# Public self-service (managed + fixed HTTPS origin). Keep off until the launch checks and real acceptance pass.
OATHRA_PUBLIC_SIGNUP=false
# Read/draft-only remote MCP with browser OAuth. Keep off until the real public origin is deployed.
# The MCP token cannot dial, approve calls, purchase credits or send follow-up messages.
OATHRA_MCP_ENABLED=false
# Restricted public prerelease: restart after edits. Pause blocks NEW registrations, purchases and calls.
# Existing payments can still be reconciled; stop an active call with its existing cancel control.
OATHRA_RELEASE_STAGE=prerelease
OATHRA_PRERELEASE_PAUSED=true
OATHRA_PRERELEASE_MAX_ACCOUNTS=10
# Low-cost launch profile: tighter than the code defaults (3 per account / 20 total).
# Each limit covers a rolling 24 hours, including approved reservations.
OATHRA_PRERELEASE_DAILY_CALLS=1
OATHRA_PRERELEASE_GLOBAL_DAILY_CALLS=5
OATHRA_PRERELEASE_MAX_SECONDS=180
# Total approved maximums over a rolling 24 hours, not a promised carrier bill ceiling.
# Zero refuses every call. Set a real operator-approved budget before opening; no example budget is invented.
OATHRA_PRERELEASE_GLOBAL_DAILY_USD=0
# Existing OATHRA_MAX_CALL_USD / OATHRA_DAILY_USD further restrict each account.
# Inbound calls are disabled in prerelease, including callbacks. No free credits are issued on registration.
RESEND_API_KEY=
# Plain lowercase address on your verified sending domain; no display-name syntax.
OATHRA_MAIL_FROM=
OATHRA_TERMS_URL=
OATHRA_PRIVACY_URL=
OATHRA_TERMS_VERSION=
# Actual published operator, prices/credit validity/refunds, and a working support contact.
OATHRA_COMMERCE_URL=
OATHRA_SUPPORT_URL=
# Live Stripe keys only. Never put these in browser code or paste them in chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON array: each object has id, priceId (a real active one-time Stripe Price), credits (positive integer), optional name.
# Price and currency are fetched from Stripe; no client-defined amount is charged.
OATHRA_CREDIT_PACKS_JSON=[]
# See docs/quality/public-service.md for configuration and acceptance checks.
# OATHRA_CREDITS_PER_CALL=
# A fixed credit charge per execution claim, including pre-connection failures/no answer.
# Simulator calls consume 0. This does not configure purchases or a payment provider.
# Optional metered policy, replacing the fixed charge for NEW calls only.
# OATHRA_CREDIT_POLICY=provider-cost-v1
# OATHRA_CREDIT_USD=0.01
# If your Twilio account bills in JPY, explicitly set a reviewed conversion and its date.
# OATHRA_CARRIER_JPY_PER_USD=
# OATHRA_CARRIER_FX_DATE=YYYY-MM-DD
# GPT-Live is priced per started session minute; verify your current contract before enabling. Model must match OATHRA_VOICE_MODEL.
# Requires the builtin call adapter; no handoff.
# OATHRA_LIVE_PRICES_JSON='{"model":"gpt-live-1","version":"2026-09-20","perMinute":"0.05"}'
# 0 for OATHRA_DAILY_CALLS / OATHRA_DAILY_USD disables that daily limit.
# Per-call ceilings and credit reservations still apply. Taxes/STT/media streams are operator-paid.

# Optional immediate service-charge settlement; no later automatic top-up/debit.
# OATHRA_SETTLEMENT_MODE=usage-rate-v1
# OATHRA_USAGE_PRICES_JSON=<reviewed JSON with version/carrier prefixes/mediaPerMinute/search; see README>
# In usage-rate-v1, media/search are metered; lost quantities and invoice differences are operator-paid.

# Optional: answer incoming calls with the AI. Off unless OATHRA_INBOUND_OWNER is set. The owner pays for them from
# their credits; the caller is never charged by this service. The AI says whose phone it looks after, takes the
# caller's name, message and call-back wish, and promises nothing. Someone returning a call that this service placed
# reaches whoever asked for that call instead. When the AI cannot answer (not enabled, no credits, line busy, rate
# limit, caller opted out) the caller hears a Japanese announcement and can press 2 to stop calls from this number.
# OATHRA_INBOUND_OWNER=operator
# OATHRA_INBOUND_NAME=堀尾
# OATHRA_INBOUND_MAX_SECONDS=180
# OATHRA_INBOUND_PER_CALLER_PER_HOUR=3
# OATHRA_INBOUND_PER_HOUR=12
# Optional: answer as a restaurant's reservation desk instead of taking messages. Tables per seating time; only
# these times can be booked. closedWeekdays: 0 = Sunday. OATHRA_INBOUND_NAME is not needed in this mode.
# OATHRA_RESTAURANT_JSON={"name":"ビストロ灯","slots":{"18:00":2,"19:00":2,"19:30":1,"20:00":2},"maxParty":6,"closedWeekdays":[1],"closedDates":["2026-12-31"]}
# Metered billing also needs an inbound price in OATHRA_USAGE_PRICES_JSON, for the country of YOUR number:
#   "inbound":{"currency":"JPY","perMinute":"1.371888","incrementSeconds":60,"source":"https://pricing.twilio.com/v2/Voice/Countries/US"}
# Then point the number at the gateway: node --env-file=<env> apps/gateway/inbound-setup.mjs --apply

# Staff alerts (optional). A call that hears something a person should read now (a fall, 「助けて」), a wellbeing
# call nobody answered, or a worrying check-in answer is POSTed here as JSON, signed with
# x-oathra-signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of "<t>.<body>">. HTTPS only.
# The alert says where to look; it carries what was said only when OATHRA_ALERT_INCLUDE_QUOTES=true.
# OATHRA_ALERT_WEBHOOK_URL=https://example.org/oathra-alerts
# OATHRA_ALERT_WEBHOOK_SECRET=<at least 32 characters>
# OATHRA_ALERT_INCLUDE_QUOTES=false

# Hours (Japan time, HH:MM-HH:MM, or off). Real sales calls are placed only inside OATHRA_SALES_CALL_HOURS
# (default 09:00-20:00); a call approved earlier and reached later is not dialled. Ordinary requests have no
# default window; set OATHRA_REQUEST_CALL_HOURS to give them one. OATHRA_INBOUND_HOURS is when the line answers.
# OATHRA_SALES_CALL_HOURS=09:00-20:00
# OATHRA_REQUEST_CALL_HOURS=08:00-21:00
# OATHRA_INBOUND_HOURS=10:00-21:00

# A deploy (SIGTERM) takes no new call and waits this long for the call in progress before stopping.
# Keep the container's stop grace period above it (deploy/compose.yml uses 360s).
# OATHRA_SHUTDOWN_GRACE_SECONDS=330

# A business line: the number answers as the business in OATHRA_INBOUND_NAME ("丸山商事です。AIアシスタントが承ります"),
# takes the caller's name, purpose and call-back details, and answers on its own ONLY from the short answers below
# (at most 30; q up to 80 characters, a up to 300). Anything else is taken as a message for the staff.
# OATHRA_INBOUND_BUSINESS=true
# OATHRA_INBOUND_GUIDANCE_JSON=[{"q":"営業時間","a":"平日の9時から18時です。"},{"q":"所在地","a":"東京都千代田区一番町1-1です。"}]

# Calls in progress at once (1-20; default 1). Raise it only after checking that the phone carrier's concurrent-call
# allowance, the voice model's rate limits and this host can carry that many. Two calls never go to the same number
# together, and an incoming call hears a busy notice once every line is in use. Unverified beyond one line on real calls.
# OATHRA_MAX_CONCURRENT_CALLS=1

# Where a caller who asks for a person ("担当の方に代わってください") is put through, in E.164. A plain carrier transfer:
# nothing after it is recorded or transcribed. Not available under metered billing; the AI then takes a message.
# OATHRA_INBOUND_TRANSFER_TO=+81312345678

# More business lines on this gateway, one per number (all on the same carrier account). Each answers as its own
# business for its own owner; the same fields as the main line. The main line stays OATHRA_INBOUND_*.
# OATHRA_INBOUND_LINES_JSON=[{"number":"+815011110000","owner":"care-manager","name":"ひかり苑","hours":"09:00-18:00","transferTo":"+81312345678","guidance":[{"q":"面会時間","a":"10時から16時です。"}]}]
