# Run node apps/gateway/setup.mjs to generate private credentials; never commit .env.gateway.
OATHRA_MODE=simulator
OATHRA_PUBLIC_URL=http://localhost:4244
HOST=127.0.0.1
PORT=4244
OATHRA_DB=.oathra/gateway.sqlite
OATHRA_DATA_KEY=
OATHRA_USERS_JSON=
# Live: use your HTTPS public origin and remove simulator contacts/products.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
OPENAI_API_KEY=
OATHRA_VOICE_ENGINE=realtime
OATHRA_VOICE_MODEL=
OATHRA_BUSINESS_NAME=
# Operator-maintained conservative ceiling per leg, not a quoted carrier tariff.
OATHRA_RATE_CEILING_USD=1
OATHRA_SETUP_FEE_USD=0
OATHRA_MAX_CALL_USD=10
OATHRA_MAX_SECONDS=300
OATHRA_DAILY_CALLS=20
OATHRA_DAILY_USD=30
OATHRA_LIVE_POLICY_REVIEWED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional external writes; credentials belong exclusively to this configured operator.
OATHRA_INTEGRATION_OWNER=operator
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
HUBSPOT_ACCESS_TOKEN=
OATHRA_SMS_ENABLED=false
