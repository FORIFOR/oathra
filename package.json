{
  "name": "oathra-monorepo",
  "private": true,
  "version": "0.1.18",
  "description": "Playable, verifiable phone actions for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/bundle-cli.mjs",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:arena-outcome": "pnpm build && node scripts/verify-arena-outcome.mjs && node scripts/ui/arena-recovery.mjs && node scripts/ui/arena-zoom.mjs",
    "test:ui": "tsc -b tsconfig.build.json && node scripts/bundle-cli.mjs && node scripts/ui/gateway-flow.mjs && node scripts/ui/arena-flow.mjs",
    "test:ui:managed": "for s in managed-phone managed-states managed-bookings managed-credits managed-recovery metered-credits usage-cost email-login; do node scripts/ui/$s.mjs || exit 1; done",
    "ui:gate:test": "node --test tests/ui-gate.test.mjs",
    "test:gateway": "tsc -b tsconfig.build.json && node --test apps/gateway/test/*.node.mjs",
    "lint:deps": "node scripts/check-deps.mjs",
    "oathra": "tsc -b tsconfig.build.json && node packages/cli/dist/bin.js",
    "demo": "tsc -b tsconfig.build.json && node packages/cli/dist/bin.js demo",
    "demo:tunnel": "tsc -b tsconfig.build.json && node packages/cli/dist/bin.js demo --tunnel",
    "demo:remote": "tsc -b tsconfig.build.json && node packages/cli/dist/bin.js demo --allow-remote",
    "desktop": "cd apps/desktop && cargo tauri dev",
    "desktop:build": "cd apps/desktop && cargo tauri build",
    "first-proof": "tsc -b tsconfig.build.json && node packages/cli/dist/bin.js demo",
    "doctor": "tsc -b tsconfig.build.json && node packages/cli/dist/bin.js doctor",
    "clean": "rm -rf packages/*/dist providers/*/dist apps/*/dist",
    "bundle": "node scripts/bundle-cli.mjs",
    "qa:arena": "node scripts/qa-arena.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
