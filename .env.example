# Oathra — copy this file to .env, then fill only the provider you use.
# The CLI also creates/updates .env when you run `oathra setup phone`.
# Never commit .env. It is ignored by git.

# Voice engines
# GPT-Live and OpenAI Realtime need this key.
OPENAI_API_KEY=
# Pipeline also needs Deepgram for speech-to-text.
DEEPGRAM_API_KEY=
# Optional alternative brain for `oathra play --brain gemini`.
GEMINI_API_KEY=
# Optional local brain (no key; install and start Ollama separately).
# OLLAMA_HOST=http://127.0.0.1:11434

# Twilio direct media streams (the simplest real-phone route)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional during setup: Oathra selects the first voice-capable number when blank.
TWILIO_PHONE_NUMBER=
# Optional: pass a stable public wss:// endpoint instead of starting ngrok per call.
# OATHRA_PUBLIC_WS_URL=

# Plivo or custom SIP (requires all three LiveKit values)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Custom SIP only (password is kept in .env)
# SIP_PASSWORD=

# Destination for `oathra phone test --level pstn` (E.164, e.g. +819012345678)
# OATHRA_TEST_PHONE=
