{
  "name": "oathra",
  "version": "0.1.10",
  "description": "Local transcript evidence checks and playable phone agents. No API key needed for verification.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oathra": "dist/bundle/bin.js"
  },
  "main": "./dist/bundle/evidence.js",
  "types": "./dist/bundle/evidence.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bundle/evidence.d.ts",
      "import": "./dist/bundle/evidence.js",
      "default": "./dist/bundle/evidence.js"
    },
    "./evidence": {
      "types": "./dist/bundle/evidence.d.ts",
      "import": "./dist/bundle/evidence.js",
      "default": "./dist/bundle/evidence.js"
    }
  },
  "files": [
    "dist/bundle",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node ../../scripts/bundle-cli.mjs",
    "prepack": "node ../../scripts/bundle-cli.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@oathra/arena": "workspace:*",
    "@oathra/contract": "workspace:*",
    "@oathra/core": "workspace:*",
    "@oathra/deepgram": "workspace:*",
    "@oathra/eval": "workspace:*",
    "@oathra/evidence": "workspace:*",
    "@oathra/gemini": "workspace:*",
    "@oathra/ollama": "workspace:*",
    "@oathra/openai": "workspace:*",
    "@oathra/replay": "workspace:*",
    "@oathra/runtime": "workspace:*",
    "@oathra/scenario": "workspace:*",
    "@oathra/simulator": "workspace:*",
    "@oathra/openai-realtime": "workspace:*",
    "@oathra/phone": "workspace:*",
    "@oathra/voice": "workspace:*",
    "@oathra/phone-twilio": "workspace:*",
    "@oathra/phone-plivo": "workspace:*",
    "@oathra/phone-sip": "workspace:*",
    "@oathra/gateway-livekit": "workspace:*",
    "@oathra/voice-pipeline": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FORIFOR/oathra.git"
  },
  "keywords": [
    "voice-agent",
    "voice-ai",
    "phone",
    "telephony",
    "ai-agents",
    "llm-agents",
    "twilio",
    "sip",
    "livekit",
    "openai",
    "gemini",
    "deepgram",
    "evidence",
    "simulator",
    "agent-evaluation"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "livekit-server-sdk": "^2.19.0",
    "@livekit/rtc-node": "^0.13.34 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "livekit-server-sdk": {
      "optional": true
    },
    "@livekit/rtc-node": {
      "optional": true
    }
  },
  "homepage": "https://forifor.github.io/oathra/"
}
